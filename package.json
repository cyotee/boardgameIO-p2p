{
  "name": "@cyotee/boardgameio-p2p",
  "version": "0.5.0",
  "description": "Peer-to-peer multiplayer transport for boardgame.io — PeerJS (upstream) and channel/join-code (ManaMesh) modes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyotee/boardgameIO-p2p.git"
  },
  "keywords": [
    "peerjs",
    "p2p",
    "multiplayer",
    "boardgame.io",
    "webrtc",
    "join-code"
  ],
  "author": "Chris Swithinbank <swithinbank@gmail.com> (http://chrisswithinbank.net/)",
  "contributors": [
    "cyotee"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cyotee/boardgameIO-p2p/issues"
  },
  "homepage": "https://github.com/cyotee/boardgameIO-p2p#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./channel": {
      "types": "./dist/channel-transport.d.ts",
      "default": "./dist/channel-transport.js"
    },
    "./trystero": {
      "types": "./dist/trystero/index.d.ts",
      "default": "./dist/trystero/index.js"
    }
  },
  "files": [
    "dist/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prettier:check": "prettier --list-different \"{src,test}/**/*.ts\"",
    "prettier:write": "prettier --write \"{src,test}/**/*.ts\"",
    "build": "tsc -b src",
    "prerelease": "npm run test && npm run build",
    "release": "standard-version -s",
    "prepublishOnly": "npm run build",
    "pretest": "eslint . || true",
    "test": "jest --coverage --collectCoverageFrom=\"src/**/*.ts\" --passWithNoTests"
  },
  "dependencies": {
    "peerjs": "^1.3.2",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "peerDependencies": {
    "boardgame.io": ">=0.49.1",
    "trystero": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "trystero": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^27.0.2",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "boardgame.io": "^0.50.2",
    "eslint": "^8.2.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^27.3.1",
    "prettier": "^3.0.3",
    "standard-version": "^9.3.1",
    "trystero": "0.25.3",
    "ts-jest": "^27.0.7",
    "typescript": "^4.4.3"
  }
}
